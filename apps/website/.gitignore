# Next.js
.next/
out/
next-env.d.ts

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Dependencies
node_modules/

# Build output
.next/standalone/
.next/static/

# Synced figures (generated from content/ at build time)
public/content/

# Generated OG share images (gen-og-images.mjs, build time)
public/assets/generated/

# Generated sitemap lastmod map (gen-content-lastmod.mjs, build time)
.generated/

# Environment
.env.local
.env*.local

# OS
.DS_Store

# LaTeX compilation temp files
.tmp/

# Playwright (browser tests). The browser binaries live outside the repo, in
# ~/.cache/ms-playwright (macOS: ~/Library/Caches/ms-playwright); these are the
# per-run artifacts it writes here.
test-results/
playwright-report/
blob-report/
.playwright/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
