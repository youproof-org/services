# Staging environment variables for the staging.youproof.hu -> staging.youproof.org migration Worker.
# Copy to staging.tfvars (gitignored) and fill in real values, OR rely on the
# CI workflow which sets these via TF_VAR_* environment variables.
#
# NOTE: legacy_guard_value is a long-lived access token, not a true secret. In
# CI it comes from a GitHub Environment *variable* (TF_VAR_legacy_guard_value).
# For local use you may set it here, but keep this real tfvars file out of git
# (only *.tfvars.example is committed).

cloudflare_account_id = "REPLACE_WITH_ACCOUNT_ID"
tfstate_bucket        = "REPLACE_WITH_R2_STATE_BUCKET" # used to read the zone root's zone_id output

environment          = "staging"
worker_domain        = "staging.youproof.hu"
redirect_target_host = "staging.youproof.org"
legacy_proxy_host    = "legacy.staging.youproof.hu"
legacy_guard_value   = "REPLACE_WITH_GUARD_VALUE"
rackhost_server_ip   = "91.227.138.40"

# staging is always served via the Worker; production_cutover is ignored here.

# NOTE: the youproof.hu zone ID is NOT set here — the worker root reads it from
# the zone root's remote state (see data.tf), using tfstate_bucket above.
